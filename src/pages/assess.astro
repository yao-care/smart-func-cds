---
import Base from '../layouts/Base.astro';
import Header from '../components/blocks/Header.astro';
import AssessmentShell from '../components/assess/AssessmentShell.svelte';
---

<Base title="開始評估" description="成人內在能力（IC）功能健康自評">
  <div class="app-layout">
    <Header />
    <main id="main-content" class="app-main" data-pagefind-body>
      <h1>成人功能健康評估</h1>
      <p class="assess-intro">
        免費的成人功能健康自評工具：依五大內在能力面向（活力 / 行動 / 認知 / 心理 / 感官）引導式作答，當下提供功能分級與衛教建議。所有運算在瀏覽器完成，資料不上傳、免登入。
      </p>
      <AssessmentShell client:load />
    </main>
  </div>
</Base>

<style>
  .app-layout {
    min-height: 100dvh;
    display: flex;
    flex-direction: column;
  }

  .app-main {
    flex: 1;
    padding: var(--space-6) var(--space-4);
    max-width: 960px;
    width: 100%;
    margin: 0 auto;
  }

  .assess-intro {
    font-size: var(--text-base);
    line-height: var(--lh-base);
    color: color-mix(in srgb, var(--text), var(--bg) 25%);
    max-width: 60ch;
    margin: 0 auto var(--space-5);
    text-align: center;
  }
</style>
