---
import App from '../layouts/App.astro';
import JsonLd from '../components/seo/JsonLd.astro';
import { organizationSchema } from '../lib/seo/schema';

const introHighlights = [
  '成人可自行操作的功能健康自評',
  '隱私優先：資料不離開瀏覽器',
  '開源免費，免登入、免安裝',
  '五大內在能力面向，依年齡適性計分',
];

const flowSteps = [
  {
    title: '輸入年齡',
    desc: '以出生日期換算年齡。適用 18 歲以上，校準範圍 18–64 歲，自動歸入 3 個年齡組（18–39、40–54、55–64）。',
  },
  {
    title: '完成功能問卷',
    desc: '依五大內在能力面向（活力、行動、認知、心理、感官）施測，採用國際通用篩檢工具（WHO-5、BAT-12、PHQ-2、GAD-2、PSS-4、PROMIS Fatigue 等）。',
  },
  {
    title: '逐面向計分、分級',
    desc: '五大面向各自彙整為 0–100 的功能分數，並依分數分為三級：',
    criteria: [
      '70 分以上：功能良好',
      '40–69 分：待觀察',
      '低於 40 分：偏低',
    ],
  },
  {
    title: '綜合判讀（四級分流）',
    desc: '依各面向分級、臨床切點旗標與完成面向數，分為四級：',
  },
];

const outcomes = [
  { key: 'normal', tag: '功能良好', cond: '所有已測面向皆良好且無臨床切點', action: '維持良好生活習慣' },
  { key: 'observe', tag: '建議觀察', cond: '1 個面向待觀察，或有 advisory 切點', action: '建議自我管理並追蹤' },
  { key: 'consult', tag: '建議諮詢醫師', cond: '任一面向偏低、≥ 2 面向待觀察，或達 consult 切點', action: '建議找醫師討論' },
  { key: 'incomplete', tag: '評估未完成', cond: '完成面向少於 3 個', action: '建議完成評估再看整體結果' },
];
---

<App title="關於" description="關於 Smart Func 成人功能健康評估：免費、純瀏覽器、保護隱私的成人內在能力（IC）自評工具。">
  <JsonLd data={organizationSchema(Astro.site!)} />

  <h1>關於 Smart Func 成人功能健康評估</h1>

  <section class="about-section about-twocol" aria-label="系統介紹">
    <div class="twocol-main">
      <h2>系統介紹</h2>
      <p>
        Smart Func 是一套開源、免費的成人功能健康自評工具，聚焦世界衛生組織提出的「內在能力（Intrinsic Capacity, IC）」框架。
        使用者依年齡引導式作答，當下取得五大內在能力面向的功能分級與對應衛教建議。
        所有運算都在瀏覽器端完成，資料不離開裝置、不收集、不轉傳。
      </p>
    </div>
    <aside class="twocol-aside" aria-label="重點摘要">
      <h3>重點摘要</h3>
      <ul>
        {introHighlights.map((h) => <li>{h}</li>)}
      </ul>
    </aside>
  </section>

  <section class="about-section flow-section" aria-label="評估判讀流程">
    <h2>評估判讀流程</h2>
    <p class="flow-intro">
      從使用者的年齡開始，到產生衛教建議為止，系統的判讀邏輯如下。
      本流程僅為功能健康分流參考，不取代專業臨床判斷。
    </p>

    <ol class="flow">
      {flowSteps.map((step) => (
        <li class="flow-step">
          <h3>{step.title}</h3>
          <p>{step.desc}</p>
          {step.criteria && (
            <ul class="flow-criteria">
              {step.criteria.map((c) => <li>{c}</li>)}
            </ul>
          )}
        </li>
      ))}
    </ol>

    <div class="flow-branch" aria-hidden="true">↓</div>

    <div class="flow-outcomes" role="list" aria-label="四級分流結果">
      {outcomes.map((o) => (
        <div class={`outcome outcome-${o.key}`} role="listitem">
          <span class="outcome-tag">{o.tag}</span>
          <p class="outcome-cond">{o.cond}</p>
          <p class="outcome-action">{o.action}</p>
        </div>
      ))}
    </div>

    <div class="flow-branch" aria-hidden="true">↓</div>

    <div class="flow-edu">
      <h3>提供衛教資源</h3>
      <p>判讀為<strong>建議觀察</strong>或<strong>建議諮詢醫師</strong>時，依「分級 × 待加強面向」自動帶出：</p>
      <ul class="flow-criteria">
        <li><strong>建議閱讀</strong>：對應的衛教文章（內容可由各院所自訂）</li>
        <li><strong>參考影片</strong>：對應主題的精選衛教影片</li>
      </ul>
      <p class="flow-note">判讀為「功能良好」時，僅顯示結果摘要與內在能力雷達圖，不另行推送衛教資源。</p>
    </div>
  </section>

  <section class="about-cta" aria-label="開始評估">
    <a href="/assess/" class="cta-primary">開始評估</a>
  </section>
</App>

<style>
  h1 {
    margin-bottom: var(--space-6);
  }

  .about-section {
    margin-bottom: var(--space-8);
  }

  .about-section h2 {
    font-size: var(--text-2xl);
    line-height: var(--lh-2xl);
    font-weight: var(--font-bold);
    margin-bottom: var(--space-4);
    color: var(--text);
  }

  .about-section p {
    font-size: var(--text-base);
    line-height: var(--lh-base);
    color: color-mix(in srgb, var(--text), var(--bg) 30%);
    max-width: 72ch;
  }

  /* ---------- 兩欄版面（系統介紹）---------- */
  .about-twocol {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 18rem);
    gap: var(--space-6);
    align-items: start;
  }

  .twocol-aside {
    background-color: var(--surface);
    border: 1px solid var(--line);
    border-radius: var(--radius-md);
    padding: var(--space-5);
  }

  .twocol-aside h3 {
    font-size: var(--text-base);
    font-weight: var(--font-bold);
    margin-bottom: var(--space-3);
    color: var(--text);
  }

  .twocol-aside ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }

  .twocol-aside li {
    font-size: var(--text-sm);
    line-height: var(--lh-sm);
    color: color-mix(in srgb, var(--text), var(--bg) 25%);
  }

  .twocol-aside li::before {
    content: '✓ ';
    color: var(--accent);
  }

  @media (max-width: 767px) {
    .about-twocol {
      grid-template-columns: 1fr;
    }
  }

  /* ---------- 評估判讀流程 ---------- */
  .flow-intro {
    max-width: 72ch;
  }

  .flow {
    list-style: none;
    margin: var(--space-5) 0 0;
    padding: 0;
    counter-reset: step;
  }

  .flow > li {
    position: relative;
    padding-left: calc(2.5rem + var(--space-4));
    padding-bottom: var(--space-5);
  }

  .flow > li::before {
    counter-increment: step;
    content: counter(step);
    position: absolute;
    left: 0;
    top: 0;
    width: 2.5rem;
    height: 2.5rem;
    border-radius: 50%;
    background-color: var(--accent);
    color: var(--bg);
    font-weight: var(--font-bold);
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .flow > li:not(:last-child)::after {
    content: '';
    position: absolute;
    left: 1.25rem;
    top: 2.5rem;
    bottom: 0;
    width: 2px;
    background-color: var(--line);
    transform: translateX(-1px);
  }

  .flow > li h3 {
    font-size: var(--text-lg);
    line-height: var(--lh-lg);
    font-weight: var(--font-bold);
    margin: 0 0 var(--space-2);
    color: var(--text);
  }

  .flow > li p {
    font-size: var(--text-base);
    line-height: var(--lh-base);
    color: color-mix(in srgb, var(--text), var(--bg) 25%);
    max-width: 72ch;
    margin: 0;
  }

  .flow-criteria {
    margin: var(--space-2) 0 0;
    padding-left: var(--space-5);
  }

  .flow-criteria li {
    font-size: var(--text-sm);
    line-height: var(--lh-sm);
    color: color-mix(in srgb, var(--text), var(--bg) 25%);
    margin-bottom: var(--space-1);
  }

  .flow-branch {
    text-align: center;
    font-size: var(--text-2xl);
    line-height: 1;
    color: color-mix(in srgb, var(--text), var(--bg) 45%);
    margin: var(--space-2) 0;
  }

  .flow-outcomes {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    gap: var(--space-4);
  }

  .outcome {
    background-color: var(--surface);
    border: 1px solid var(--line);
    border-top: 4px solid var(--line);
    border-radius: var(--radius-md);
    padding: var(--space-4);
  }

  .outcome p {
    font-size: var(--text-sm);
    line-height: var(--lh-sm);
    color: color-mix(in srgb, var(--text), var(--bg) 20%);
    max-width: none;
    margin: 0 0 var(--space-1);
  }

  .outcome .outcome-action {
    font-weight: var(--font-medium);
    color: var(--text);
  }

  .outcome-tag {
    display: inline-block;
    font-size: var(--text-sm);
    font-weight: var(--font-bold);
    color: var(--bg);
    padding: var(--space-1) var(--space-3);
    border-radius: var(--radius-sm);
    margin-bottom: var(--space-2);
  }

  .outcome-normal {
    border-top-color: var(--accent);
    background-color: color-mix(in srgb, var(--accent) 10%, var(--bg));
  }
  .outcome-normal .outcome-tag {
    background-color: var(--accent);
  }

  .outcome-observe {
    border-top-color: var(--warn);
    background-color: color-mix(in srgb, var(--warn) 10%, var(--bg));
  }
  .outcome-observe .outcome-tag {
    background-color: var(--warn);
  }

  .outcome-consult {
    border-top-color: var(--danger);
    background-color: color-mix(in srgb, var(--danger) 12%, var(--bg));
  }
  .outcome-consult .outcome-tag {
    background-color: var(--danger);
  }

  .outcome-incomplete {
    border-top-color: var(--line);
    background-color: color-mix(in srgb, var(--text) 5%, var(--bg));
  }
  .outcome-incomplete .outcome-tag {
    background-color: color-mix(in srgb, var(--text), var(--bg) 25%);
  }

  .flow-edu {
    margin-top: var(--space-5);
    background-color: var(--surface);
    border: 1px solid var(--line);
    border-radius: var(--radius-md);
    padding: var(--space-5);
  }

  .flow-edu h3 {
    font-size: var(--text-lg);
    line-height: var(--lh-lg);
    font-weight: var(--font-bold);
    margin: 0 0 var(--space-3);
    color: var(--text);
  }

  .flow-note {
    margin-top: var(--space-3);
    font-style: italic;
  }

  /* ---------- 底部 CTA ---------- */
  .about-cta {
    text-align: center;
    padding: var(--space-6) 0;
    border-top: 1px solid var(--line);
  }

  .about-cta .cta-primary {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 44px;
    padding: var(--space-3) var(--space-6);
    font-size: var(--text-lg);
    font-weight: var(--font-bold);
    color: var(--bg);
    background-color: var(--accent);
    border-radius: var(--radius-md);
    text-decoration: none;
  }

  .about-cta .cta-primary:hover {
    background-color: color-mix(in srgb, var(--accent), black 12%);
  }
</style>
